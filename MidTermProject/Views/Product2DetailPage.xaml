<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
x:Class="MidTermProject.Views.Product2DetailPage"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
Title="Mana Elixir">

    <VerticalStackLayout Padding="20">

        <Label Text="Mana Elixir" FontSize="28" />
        <Label Text="$10.00" TextColor="Red" />
        <Label Text="Restores magical energy." />
        <Label Text="In stock" TextColor="Green" />

        <Label Text="Quantity" />
        <Entry x:Name="QuantityEntry" Text="1" />

        <Button Text="Add to cart" BackgroundColor="Orange" Clicked="OnAddClicked" />

        <Label x:Name="MessageLabel" />

    </VerticalStackLayout>

</ContentPage>
