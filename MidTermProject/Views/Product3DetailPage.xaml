<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
x:Class="MidTermProject.Views.Product3DetailPage"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
Title="Firebomb Vial">

    <VerticalStackLayout Padding="20">

        <Label Text="Firebomb Vial" FontSize="28" />
        <Label Text="$15.00" TextColor="Red" />
        <Label Text="Explosive alchemical mixture." />
        <Label Text="In stock" TextColor="Green" />

        <Label Text="Quantity" />
        <Entry x:Name="QuantityEntry" Text="1" />

        <Button Text="Add to cart" BackgroundColor="Orange" Clicked="OnAddClicked" />

        <Label x:Name="MessageLabel" />

    </VerticalStackLayout>

</ContentPage>
