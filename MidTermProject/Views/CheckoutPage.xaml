<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
x:Class="MidTermProject.Views.CheckoutPage"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
Title="Checkout">

    <VerticalStackLayout Padding="20">

        <Label Text="Your basket" FontSize="28" />
        <Label Text="Nothing in here yet." FontSize="18" />

        <Label Text="Total: $0.00" FontSize="22" HorizontalOptions="End" Margin="0,40,0,0" />

        <Button Text="Checkout" BackgroundColor="Orange" />

    </VerticalStackLayout>

</ContentPage>
